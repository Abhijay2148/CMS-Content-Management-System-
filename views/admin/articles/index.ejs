<div id="admin-content">
      <div class="container">
          <div class="row">
              <div class="col-md-10">
                  <h1 class="admin-heading"><i class="fa fa-file-text"></i> All Articles</h1>
              </div>
              <div class="col-md-2">
                  <a class="add-new" href="/admin/add-article">Add New Article</a>
              </div>
              <div class="col-md-12">
                  <div id="articlesTable"></div>
              </div>
          </div>
      </div>
  </div>

  

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/tabulator-tables@6.5.0/dist/js/tabulator.min.js"></script>

<script>
  const tableData = <%- JSON.stringify(articles) %>

  var table = new Tabulator("#articlesTable", {
    data: tableData,
    layout: "fitColumns",
    pagination: true,
    paginationSize: 10,
    paginationSizeSelector: [5, 10, 25, 50, 100],
    columns: [
        {
            title: "ID",
            formatter: "rownum",
            width: 50,
            hozAlign: "center",
        }
    ,{
        title: "Title",
        field: "title",
        headerFilter: "input"
      },
      {
        title: "Category",
        field: "category.name",
        headerFilter: "input"
      },
      {
        title: "Date",
        field: "createdAt",
        headerFilter: "input",
        formatter: function(cell, formatterParams, onRendered) {
        if (cell.getData().createdAt) {
          return new Date(cell.getData().createdAt).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });
        }
        }
      },
      {
        title: "Author",
        field: "author.fullname",
        headerFilter: "input"
      },
      {
        title: "Actions",
        formatter: function(cell, formatterParams, onRendered) {
          return `<a href="/admin/update-article/${cell.getData()._id}" class="btn btn-sm btn-success">Edit</a>
                    <button class="btn btn-sm btn-danger delete-article" onclick="deleteArticle('${cell.getData()._id}')">Delete</button>`;
        }
      }
    ],
  });


  //Delete Category Function
window.deleteArticle = async function(categoryId) {
  try {
    if (confirm("Are you sure you want to delete this Article?")) {
      const response = await fetch(`/admin/delete-article/${categoryId}`, { method: 'DELETE' });
      if (response.ok) {
        window.location.reload();
      } else {
        console.error('Delete failed:', response.status);
      }
    }
  } catch (error) {
    console.error('Error deleting Article:', error);
  }
};

  
</script>

<%- contentFor('tabulatorCSS') %>
<link href="https://unpkg.com/tabulator-tables@6.5.0/dist/css/tabulator.min.css" rel="stylesheet">
<link href="/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">